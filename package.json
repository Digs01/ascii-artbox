{
    "name": "asciiweb",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "format": "prettier --write \"**/*.{ts,tsx,md}\""
    },
    "devDependencies": {
        "turbo": "^2.0.0",
        "typescript": "^5.3.0",
        "prettier": "^3.2.0",
        "eslint": "^8.56.0"
    },
    "packageManager": "npm@10.0.0"
}